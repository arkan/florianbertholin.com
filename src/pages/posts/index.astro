---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Posts from "../../components/Posts.astro";
import { formatBlogPosts } from "../../js/utils";

const allPosts = Object.values(import.meta.glob("./*.md", { eager: true }));
const formattedPosts = formatBlogPosts(allPosts);
---

<Layout
    title="Blog"
    description="My thoughts on software engineering, leadership, and life"
>
    <article class="posts-page" aria-labelledby="posts-title">
        <PageHeader
            title="Posts"
            description="My thoughts on software engineering, leadership, and life"
            headingId="posts-title"
            layout="split"
        />

        <Posts posts={formattedPosts} />
    </article>
</Layout>

<style>
    .posts-page {
        width: 100%;
        max-width: 52rem;
        margin-inline: auto;
        padding-block: clamp(0.5rem, 2vw, 1.5rem) 1rem;
    }
</style>
