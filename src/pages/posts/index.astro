---
import Layout from "../../layouts/Layout.astro";
import { formatDate, formatBlogPosts } from "../../js/utils";

const allPosts = await Astro.glob("./*.md");
const formattedPosts = formatBlogPosts(allPosts);
---

<Layout
    title="Blog"
    description="My thoughts on software engineering, leadership, and life"
>
    <div class="text-center">
        <h1 class="text-4xl mt-0 mb-0 font-extrabold">Blog</h1>

        <h2
            class="text-xl mt-0 mb-0 font-normal text-neutral-500 dark:text-neutral-400"
        >
            My thoughts on software engineering, leadership, and life
        </h2>

        <div class="mt-10 max-w-3xl mx-auto">
            <div class="grid gap-6">
                {
                    formattedPosts.map((post) => (
                        <div class="card bg-base-100 shadow-lg hover:shadow-xl transition-shadow duration-300">
                            <div class="card-body">
                                <h3 class="card-title text-xl font-bold mb-2">
                                    <a
                                        href={post.url}
                                        class="link link-hover link-primary transition-colors duration-200"
                                    >
                                        {post.frontmatter.title}
                                    </a>
                                </h3>
                                <div class="flex gap-2 items-center text-sm text-neutral-500 dark:text-neutral-400">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 mr-2"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                        />
                                    </svg>
                                    {formatDate(post.frontmatter.date)}
                                    <div class="flex items-center gap-2">
                                        <span class="badge ">
                                            <a
                                                href={`/posts?category=${post.frontmatter.category}`}
                                                class="link link-hover link-primary"
                                            >
                                                {post.frontmatter.category}
                                            </a>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</Layout>
