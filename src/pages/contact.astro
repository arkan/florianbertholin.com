---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Florian from "../images/florian3.png";
import Annecy2 from "../images/annecy2.png";
---

<Layout title="Contact" description="Get in touch with me">
	<div class="text-center">
		<h1 class="text-4xl mt-0 mb-0 font-extrabold">Contact</h1>

		<h2
			class="text-xl mt-0 mb-0 font-normal text-neutral-500 dark:text-neutral-400"
		>
			Get in touch with me
		</h2>

		<div class="mt-10">
			<div class="flex justify-center">
				<Image
					src={Florian}
					alt="Florian"
					width={144}
					height={144}
					quality={70}
					class="rounded-avatar"
				/>
			</div>
			<div
				class="prose prose-lg text-gray-700 space-y-6 text-justify mx-auto mt-10"
			>
				<p>
					I’m always eager to hear from readers, whether it’s feedback
					on the blog or just a quick hello. You can reach me directly
					at <a
						class="link link-hover link-primary"
						href="mailto:florian@bertholin.com"
						>florian@bertholin.com</a
					>.
				</p>

				<p>
					You can also connect with me on
					<a
						class="link link-hover link-primary"
						href="https://linkedin.com/in/fbertholin">Linkedin</a
					> and follow my work on
					<a
						class="link link-hover link-primary"
						href="https://github.com/arkan">Github</a
					>.
				</p>
				<div class="flex justify-center">
					<Image
						src={Annecy2}
						alt="Annecy"
						width={1000}
						height={1000}
						quality={70}
					/>
				</div>
			</div>
		</div>
	</div>
</Layout>
