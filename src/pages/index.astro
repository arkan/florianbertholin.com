---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Florian from "../images/florian3.png";
---

<Layout title="Florian Bertholin" description="Engineering Leader & Mentor">
    <article class="home-page">
        <section class="home-hero" aria-labelledby="home-title">
            <div class="home-introduction">
                <h1 id="home-title" class="home-title font-editorial">
                    <span>Florian</span>
                    <span>Bertholin</span>
                </h1>

                <p class="home-role">Engineering Leader &amp; Mentor</p>

                <p class="home-lead">
                    I work where engineering leadership meets long-lived
                    software: modernizing complex systems, building with Go,
                    and helping engineers grow.
                </p>

                <ul class="home-links" aria-label="Contact and social links">
                    <li>
                        <a href="mailto:florian@bertholin.com">Email</a>
                    </li>
                    <li>
                        <a
                            href="https://github.com/arkan"
                            target="_blank"
                            rel="me noopener noreferrer">GitHub</a
                        >
                    </li>
                    <li>
                        <a
                            href="https://linkedin.com/in/fbertholin"
                            target="_blank"
                            rel="me noopener noreferrer">LinkedIn</a
                        >
                    </li>
                </ul>
            </div>

            <figure class="home-portrait">
                <Image
                    src={Florian}
                    alt="Portrait of Florian Bertholin by the water"
                    width={420}
                    quality={85}
                    sizes="(max-width: 767px) 208px, 280px"
                    loading="eager"
                />
                <figcaption>Based in Annecy, France</figcaption>
            </figure>
        </section>

        <section class="home-section" aria-labelledby="current-work-title">
            <h2 id="current-work-title" class="font-editorial">
                Modernizing a decades-old application.
            </h2>
            <div class="home-prose">
                <p>
                    These days, I’m working with Go, microservices, and
                    infrastructure to bring a long-lived application forward.
                </p>
                <p>
                    I’ve worked in technology since 2008, focusing on Go,
                    microservice architectures, and infrastructure since 2013.
                    That experience helps me connect technical decisions with
                    real business needs.
                </p>
            </div>
        </section>

        <section class="home-section" aria-labelledby="sharing-title">
            <h2 id="sharing-title" class="font-editorial">
                Sharing what I learn along the way.
            </h2>
            <div class="home-prose">
                <p>
                    Alongside my day-to-day work, I write, review technical
                    books, and mentor engineers as they grow in their careers.
                </p>
                <p>
                    If you’d like to compare notes on engineering leadership,
                    system modernization, or mentoring, you can
                    <a href="/posts/" class="site-text-link"
                        >read my latest posts</a
                    > or
                    <a href="/contact/" class="site-text-link">get in touch</a>.
                </p>
            </div>
        </section>
    </article>
</Layout>

<style>
    .home-page {
        padding-block: clamp(0.5rem, 2vw, 1.5rem) 1rem;
    }

    .home-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(13rem, 0.65fr);
        gap: clamp(2.5rem, 7vw, 5rem);
        align-items: center;
        min-height: min(38rem, calc(100vh - 10rem));
        padding-block: clamp(2rem, 6vw, 4.5rem);
    }

    .home-title {
        max-width: 8ch;
        margin: 0;
        color: var(--site-ink);
        font-size: clamp(3.5rem, 8vw, 5.75rem);
        font-weight: 600;
        line-height: 0.9;
        letter-spacing: -0.035em;
        text-wrap: balance;
    }

    .home-title span {
        display: block;
    }

    .home-role {
        margin: 1.25rem 0 0;
        color: var(--site-accent);
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.5;
    }

    .home-lead {
        max-width: 36rem;
        margin: 1.25rem 0 0;
        color: var(--site-copy);
        font-size: clamp(1.125rem, 2vw, 1.3125rem);
        line-height: 1.55;
        text-wrap: pretty;
    }

    .home-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0 1.5rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
    }

    .home-links a {
        display: inline-flex;
        min-width: 2.75rem;
        min-height: 2.75rem;
        align-items: center;
        color: var(--site-ink);
        font-size: 0.9375rem;
        font-weight: 500;
        text-decoration-color: color-mix(in srgb, var(--site-accent) 45%, transparent);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.25em;
        transition: color 160ms ease-out;
    }

    .home-links a:hover {
        color: var(--site-accent);
        text-decoration-color: currentColor;
    }

    .home-portrait {
        width: min(100%, 17.5rem);
        margin: 0;
        justify-self: end;
    }

    .home-portrait img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 1rem;
        box-shadow: 0 22px 52px -34px rgb(32 37 34 / 65%);
    }

    .home-portrait figcaption {
        margin-top: 0.75rem;
        color: var(--site-muted);
        font-size: 0.8125rem;
        line-height: 1.5;
    }

    .home-section {
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: clamp(2rem, 7vw, 5rem);
        padding-block: clamp(3rem, 7vw, 5rem);
        border-top: 1px solid var(--site-line);
    }

    .home-section h2 {
        max-width: 13ch;
        margin: 0;
        color: var(--site-ink);
        font-size: clamp(2rem, 4vw, 2.875rem);
        font-weight: 600;
        line-height: 1.04;
        letter-spacing: -0.025em;
        text-wrap: balance;
    }

    .home-prose {
        max-width: 64ch;
        color: var(--site-copy);
        font-size: 1.0625rem;
        line-height: 1.7;
    }

    .home-prose p {
        margin: 0;
    }

    .home-prose p + p {
        margin-top: 1.25rem;
    }

    @media (max-width: 767px) {
        .home-hero {
            grid-template-columns: 1fr;
            gap: 2rem;
            min-height: auto;
            padding-block: 1.5rem 3.25rem;
        }

        .home-introduction {
            order: 2;
        }

        .home-portrait {
            order: 1;
            width: min(62vw, 13rem);
            justify-self: center;
        }

        .home-title {
            font-size: clamp(3.25rem, 16vw, 4.25rem);
        }

        .home-section {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .home-section h2 {
            max-width: 16ch;
        }

        .home-prose {
            font-size: 1rem;
            line-height: 1.65;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-links a {
            transition: none;
        }
    }
</style>
