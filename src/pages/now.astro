---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Annecy from "../images/annecy.jpg";
---

<Layout title="Now" description="What I am doing now?">
    <article class="now-page" aria-labelledby="now-title">
        <PageHeader
            title="Now"
            description="What I am doing now?"
            headingId="now-title"
            layout="split"
        />

        <div class="now-story">
            <p class="now-lead">
                I’m currently living in <strong>Annecy, France</strong>, where
                I’m working remotely to modernize a decades-old application
                using modern technologies such as Go, microservices,
                infrastructure, etc.
            </p>

            <figure class="now-figure">
                <Image
                    src={Annecy}
                    alt="The Thiou river running through Annecy's old town"
                    width={1000}
                    quality={85}
                    sizes="(max-width: 767px) calc(100vw - 2rem), 768px"
                />
            </figure>

            <p>I’m also a proud father of a beautiful daughter. ☺️</p>
        </div>
    </article>
</Layout>

<style>
    .now-page {
        width: 100%;
        max-width: 48rem;
        margin-inline: auto;
        padding-block: clamp(0.5rem, 2vw, 1.5rem) 1rem;
    }

    .now-story {
        color: var(--site-copy);
        font-size: 1.0625rem;
        line-height: 1.7;
    }

    .now-story p {
        max-width: 66ch;
        margin: 0;
        text-wrap: pretty;
    }

    .now-story p + p {
        margin-top: 1.5rem;
    }

    .now-lead {
        font-size: clamp(1.125rem, 2vw, 1.3125rem);
        line-height: 1.65;
    }

    .now-story strong {
        color: var(--site-ink);
        font-weight: 600;
    }

    .now-figure {
        margin: clamp(2rem, 5vw, 3rem) 0;
    }

    .now-figure img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 1rem;
        box-shadow: 0 22px 52px -34px rgb(32 37 34 / 65%);
    }

    @media (max-width: 639px) {
        .now-story {
            font-size: 1rem;
        }

        .now-lead {
            font-size: 1.0625rem;
        }
    }
</style>
