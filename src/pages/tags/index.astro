---
import Layout from "../../layouts/Layout.astro";
import { formatBlogPosts, slugify, getTags } from "../../js/utils";

const allPosts = await Astro.glob("./../posts/*.md");
const tags = getTags(formatBlogPosts(allPosts));
const tagCounts = tags.reduce((acc: any, tag: any) => {
    acc[tag] = (acc[tag] || 0) + 1;
    return acc;
}, {});
const uniqueTagsWithCount = Object.entries(tagCounts)
    .map(([tag, count]) => ({
        tag,
        count,
    }))
    .sort((a, b) => b.count - a.count);
---

<Layout
    title="Blog"
    description="My thoughts on software engineering, leadership, and life"
>
    <div class="text-center">
        <h1 class="text-4xl mt-0 mb-0 font-extrabold">Tags</h1>

        <h2 class="text-xl mt-0 mb-0 font-normal text-neutral-500">
            All tags used in my posts
        </h2>
    </div>

    <div class="mt-10 max-w-3xl mx-auto">
        <section class="mt-3 -mx-2 flex flex-wrap overflow-hidden">
            {
                uniqueTagsWithCount.map((tag: any) => (
                    <article class="my-1 py-1 w-full overflow-hidden px-2 sm:w-full ">
                        <h2>
                            <a
                                href={`/tags/${slugify(tag.tag)}`}
                                class="flex items-center group hover:bg-slate-400/20 dark:hover:bg-slate-700/20 rounded-sm"
                            >
                                <>
                                    <div class="text-xl font-medium grow decoration-darkly-500 group-hover:underline group-hover:underline-offset-2">
                                        #{tag.tag}
                                    </div>
                                    <div class="ml-1 text-xl font-medium text-neutral-400 self-start">
                                        {tag.count}
                                    </div>
                                </>
                            </a>
                        </h2>
                    </article>
                ))
            }
        </section>
    </div>
</Layout>
