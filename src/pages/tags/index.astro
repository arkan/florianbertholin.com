---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { formatBlogPosts, slugify, getTags } from "../../js/utils";

const allPosts = await Astro.glob("./../posts/*.md");
const tags = getTags(formatBlogPosts(allPosts));
const tagCounts = tags.reduce((acc: any, tag: any) => {
    acc[tag] = (acc[tag] || 0) + 1;
    return acc;
}, {});
const uniqueTagsWithCount = Object.entries(tagCounts)
    .map(([tag, count]) => ({
        tag,
        count,
    }))
    .sort((a, b) => b.count - a.count);
---

<Layout
    title="Blog"
    description="My thoughts on software engineering, leadership, and life"
>
    <article class="tags-page" aria-labelledby="tags-title">
        <PageHeader
            title="Tags"
            description="All tags used in my posts"
            headingId="tags-title"
            layout="split"
        />

        <section aria-labelledby="tags-index-title">
            <h2 id="tags-index-title" class="sr-only">Browse posts by tag</h2>

            <ul class="tag-list">
                {
                    uniqueTagsWithCount.map((tag: any) => (
                        <li>
                            <a
                                href={`/tags/${slugify(tag.tag)}`}
                                class="tag-link"
                            >
                                <span class="tag-name font-editorial">
                                    <span class="tag-hash" aria-hidden="true">
                                        #
                                    </span>
                                    {tag.tag}
                                </span>

                                <span class="tag-count">
                                    {tag.count} {tag.count === 1 ? "post" : "posts"}
                                </span>

                                <svg
                                    class="tag-arrow"
                                    xmlns="http://www.w3.org/2000/svg"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="1.75"
                                        d="M5 12h14m-5-5 5 5-5 5"
                                    />
                                </svg>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>
    </article>
</Layout>

<style>
    .tags-page {
        width: 100%;
        max-width: 48rem;
        margin-inline: auto;
        padding-block: clamp(0.5rem, 2vw, 1.5rem) 1rem;
    }

    .tag-list {
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--site-line);
        list-style: none;
    }

    .tag-list li {
        border-bottom: 1px solid var(--site-line);
    }

    .tag-link {
        display: grid;
        width: calc(100% + 1.5rem);
        min-height: 5rem;
        margin-inline: -0.75rem;
        padding: 1rem 0.75rem;
        grid-template-columns: minmax(0, 1fr) auto 1.25rem;
        gap: 1.25rem;
        align-items: center;
        border-radius: 0.75rem;
        color: inherit;
        text-decoration: none;
        transition: background-color 180ms ease-out;
    }

    .tag-name {
        min-width: 0;
        color: var(--site-ink);
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.02em;
        overflow-wrap: anywhere;
        transition: color 180ms ease-out;
    }

    .tag-hash {
        color: var(--site-accent);
    }

    .tag-count {
        color: var(--site-muted);
        font-size: 0.875rem;
        font-variant-numeric: tabular-nums;
        line-height: 1.4;
        white-space: nowrap;
        transition: color 180ms ease-out;
    }

    .tag-arrow {
        width: 1.25rem;
        height: 1.25rem;
        color: var(--site-accent);
        transform: translateX(-0.25rem);
        transition: transform 180ms ease-out;
    }

    .tag-link:hover,
    .tag-link:focus-visible {
        background: var(--site-surface);
    }

    .tag-link:hover .tag-name,
    .tag-link:focus-visible .tag-name {
        color: var(--site-accent-strong);
    }

    .tag-link:hover .tag-count,
    .tag-link:focus-visible .tag-count {
        color: var(--site-copy);
    }

    .tag-link:hover .tag-arrow,
    .tag-link:focus-visible .tag-arrow {
        transform: translateX(0);
    }

    @media (max-width: 639px) {
        .tag-link {
            width: 100%;
            min-height: 4.5rem;
            margin-inline: 0;
            padding-inline: 0.25rem;
            grid-template-columns: minmax(0, 1fr) auto 1.125rem;
            gap: 0.75rem;
        }

        .tag-count {
            font-size: 0.8125rem;
        }

        .tag-arrow {
            width: 1.125rem;
            height: 1.125rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .tag-link,
        .tag-name,
        .tag-count,
        .tag-arrow {
            transition: none;
        }
    }
</style>
