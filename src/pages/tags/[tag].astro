---
import Layout from "../../layouts/Layout.astro";
import { formatBlogPosts, slugify, getTags } from "../../js/utils";
import Posts from "../../components/Posts.astro";

export async function getStaticPaths() {
    const allPosts = await Astro.glob("./../posts/*.md");
    const formattedPosts = formatBlogPosts(allPosts);

    const tags = getTags(formattedPosts);
    const uniqueTags = [...new Set(tags)];
    const paths = uniqueTags.map((tag) => ({
        params: { tag: slugify(tag) },
    }));

    return paths;
}

const { tag } = Astro.params;
const allPosts = await Astro.glob("./../posts/*.md");
const formattedPosts = formatBlogPosts(allPosts, { tag });
---

<Layout
    title="Blog"
    description="My thoughts on software engineering, leadership, and life"
>
    <div class="text-center">
        <h1 class="text-4xl mt-0 mb-0 font-extrabold">
            Blog posts about <span class="text-primary">#{tag}</span>
        </h1>

        <h2 class="text-xl mt-0 mb-0 font-normal text-neutral-500">
            My thoughts on software engineering, leadership, and life
        </h2>

        <Posts posts={formattedPosts} />
    </div>
</Layout>
