---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Annecy from "../images/annecy.jpg";
import Florian from "../images/florian3.png";
import { resume } from "../data/resume";
import iconLink from "../images/icon-link.png";
import iconPDF from "../images/icon-pdf.png";
---

<Layout title="Now" description="What I am doing now?">
    <div class="text-center">
        <h1 class="text-4xl mt-0 mb-0 font-extrabold">{resume.title}</h1>

        <h2
            class="text-xl mt-0 mb-0 font-normal text-neutral-500 dark:text-neutral-400"
        >
            {resume.subtitle}
        </h2>

        <div class="mt-10">
            <div class="flex flex-col lg:flex-row gap-x-10 mt-10">
                <div class="w-full lg:w-2/6">
                    <div class="flex flex-col items-center mb-8">
                        <Image
                            src={Florian}
                            alt="Florian Bertholin"
                            class="rounded-avatar"
                        />
                        <a href="/render-resume" target="_blank">
                            <Image
                                src={iconPDF}
                                alt="icon-link"
                                class="w-10 h-10 ml-1 mt-4 hover:scale-105 transition-transform"
                            />
                        </a>
                    </div>
                    <!-- contact details -->

                    <strong class="text-xl font-medium">Contact Details</strong>
                    <ul class="mt-2 mb-10">
                        <li class="px-2 mt-1">
                            <strong class="mr-1">E-mail </strong>
                            <a
                                href={`mailto:${resume.email}`}
                                class="block link link-hover link-primary"
                                >{resume.email}</a
                            >
                        </li>
                        <li class="px-2 mt-1">
                            <strong class="mr-1">Location</strong>
                            <a
                                href={resume.locationLink}
                                target="_blank"
                                class="block link link-hover link-primary"
                                >{resume.location}</a
                            >
                        </li>
                    </ul>

                    <!-- skills -->
                    <strong class="text-xl font-medium">Main skills</strong>
                    <ul class="mt-2 mb-10">
                        {
                            resume.skills?.map((skill) => (
                                <li class="px-2 mt-1">{skill}</li>
                            ))
                        }
                    </ul>
                </div>

                <!-- info -->
                <div class="w-full lg:w-4/6">
                    <section>
                        <!-- about me -->
                        <h2 class="text-2xl pb-1 border-b font-semibold">
                            About
                        </h2>
                        <p class="mt-4 text-xs">
                            <Fragment set:html={resume.about} />
                        </p>
                    </section>
                    <section>
                        <!-- work experiences -->
                        <h2 class="text-2xl mt-6 pb-1 border-b font-semibold">
                            Work Experiences
                        </h2>
                        <ul class="mt-2">
                            {
                                resume.workExperiences.map((experience) => (
                                    <li class="pt-2">
                                        <p class="flex justify-between text-sm">
                                            <strong class="text-base">
                                                {experience.website ? (
                                                    <a
                                                        href={
                                                            experience.website
                                                        }
                                                        target="_blank"
                                                        class="flex link link-hover link-primary"
                                                    >
                                                        <span>
                                                            {experience.company}
                                                        </span>
                                                        <Image
                                                            src={iconLink}
                                                            alt="icon-link"
                                                            class="w-5 h-5 ml-1 mt-1"
                                                        />
                                                    </a>
                                                ) : (
                                                    experience.company
                                                )}
                                            </strong>
                                            {experience.startDate}-
                                            {experience.endDate}
                                        </p>
                                        <p class="flex justify-between text-base">
                                            {experience.title}
                                            <small>{experience.location}</small>
                                        </p>
                                        <div class="text-justify text-xs">
                                            <Fragment
                                                set:html={
                                                    experience.description
                                                }
                                            />
                                            <ul
                                                class="list-disc list-outside pl-4"
                                                class:list={[
                                                    {
                                                        "mt-4": experience.description,
                                                    },
                                                ]}
                                            >
                                                {experience.items?.map(
                                                    (item) => (
                                                        <li>
                                                            {item.description}
                                                        </li>
                                                    ),
                                                )}
                                            </ul>
                                        </div>
                                    </li>
                                ))
                            }
                        </ul>
                    </section>
                    <section>
                        <!-- education -->
                        <h2 class="text-2xl mt-6 pb-1 border-b font-semibold">
                            Education
                        </h2>
                        <ul class="mt-2">
                            {
                                resume.educations.map((education) => (
                                    <li class="pt-2">
                                        <p class="flex justify-between text-xs">
                                            <strong class="text-base">
                                                {education.school}
                                            </strong>
                                            {education.startDate}-
                                            {education.endDate}
                                        </p>
                                        <p class="flex justify-between text-xs">
                                            {education.degree}
                                        </p>
                                    </li>
                                ))
                            }
                        </ul>
                    </section>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    @reference "../styles/global.css";

    .icon-action-link {
        @apply px-1 transition-transform hover:scale-125 text-neutral-500 hover:text-primary;
    }
</style>
