---
const { title, description } = Astro.props;
---

<head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:url" content="https://www.florianbertholin.com/" />
    <meta property="og:site_name" content="Florian Bertholin" />
    <meta property="og:title" content="Florian Bertholin" />
    <meta property="og:locale" content="en" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Florian Bertholin" />
    <meta name="author" content="Florian Bertholin" />
    <link href="mailto:florian@bertholin.com" rel="me" />
    <link href="https://github.com/arkan" rel="me" />
    <link href="https://linkedin.com/in/fbertholin" rel="me" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    />
</head>
